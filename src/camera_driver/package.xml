<?xml version="1.0"?>
<!-- camera_driver封装真实/模拟相机后端，厂商SDK不得越过CameraAdapter边界。 -->
<package format="3">
  <name>camera_driver</name>
  <version>0.2.4</version>
  <description>Orbbec Gemini335Le、RealSense D436 和 Mock 相机驱动。</description>
  <maintainer email="HeXuBin13@outlook.com">dyf</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <!-- 所有后端最终都输出camera_adapter统一契约。 -->
  <depend>camera_adapter</depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
