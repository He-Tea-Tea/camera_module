# 查询单台本地相机能力摘要；本Service是整机QueryCapabilities的数据源之一，不是公共替代接口。
string camera_name #逻辑相机名称，例如head_camera或wrist_camera
---
bool success #是否成功找到并返回该相机能力摘要
uint32 error_code #camera_module内部错误码；公共层必须显式映射
uint16 component_instance_id #V1.3组件实例号，1..65534且在机器人配置内唯一、跨重启稳定
uint8 component_kind #组件类别；相机固定对应V1.3 COMPONENT_CAMERA=7
uint8 device_id #公共DeviceState映射；相机固定使用V1.3 DEVICE_NONE=255
string model #真实SDK型号优先；未连接时可退回配置型号
string serial #真实SDK序列号优先；未连接时可退回配置序列号
string optical_frame #本地RGB-D三维坐标所属光学坐标系
string calibration_revision #当前相机/分辨率对应的标定制品revision
bool local_camera_available #只有相机已进入STREAMING时为true；不等价于对象已本地重确认
bool capture_delay_bound_verified #是否已通过外部实测确认采集到接收延迟上界
uint32 capture_delay_bound_ms #已验证采集延迟上界，单位毫秒；未验证时为0
uint32 max_frame_age_ms #本地三维查询允许使用的最大帧年龄
uint32 max_pair_delta_ms #RGB和Depth允许的最大设备采集时间差
string hw_ptp_level #私有摘要文本；当前none语义对应公共HW_PTP_NONE，公共层必须转强类型枚举
string closed_loop_control_location #私有摘要文本；small_brain语义对应公共CLOSED_LOOP_CEREBELLUM
string message #人类可读诊断信息
